---
import { getCollection, render } from 'astro:content';
import MermaidScript from '../../components/MermaidScript.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';

const selectedTag = Astro.url.searchParams.get('tag');

const allScraps = await getCollection('scraps');
const sortedScraps = allScraps.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(sortedScraps.flatMap((scrap) => scrap.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'ja'),
);

const visibleScraps = selectedTag
  ? sortedScraps.filter((scrap) => scrap.data.tags.includes(selectedTag))
  : sortedScraps;

const renderedScraps = await Promise.all(
  visibleScraps.map(async (scrap) => ({
    scrap,
    Content: (await render(scrap)).Content,
  })),
);
---

<BaseLayout
  currentPath="/scraps"
  title="スクラップ置き場"
  description="記事になる前のメモや気づきを積み上げていくスクラップ一覧です"
>
  <div class="container-narrow py-12">
    <header class="mb-10">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-ink-soft">Scraps Timeline</p>
      <h1 class="mt-3 text-4xl font-bold">スクラップ置き場</h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-ink-soft md:text-base">
        記事にする前のメモや気づきを、ノートの余白に書き足す感覚で積み上げています。
      </p>

      {allTags.length > 0 && (
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <a
            href="/scraps"
            class:list={[
              'rounded-full border border-dashed px-3 py-1 text-sm transition-colors',
              selectedTag
                ? 'border-rule text-ink-soft hover:border-accent hover:text-accent'
                : 'border-accent bg-marker/60 text-ink',
            ]}
          >
            すべて
          </a>
          {allTags.map((tag) => (
            <a
              href={`/scraps?tag=${encodeURIComponent(tag)}`}
              class:list={[
                'rounded-full border border-dashed px-3 py-1 text-sm transition-colors',
                selectedTag === tag
                  ? 'border-accent bg-marker/60 text-ink'
                  : 'border-rule text-ink-soft hover:border-accent hover:text-accent',
              ]}
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <ol class="relative space-y-6" aria-label="スクラップ一覧">
      {renderedScraps.map(({ scrap, Content }, index) => (
        <li class="relative pl-8">
          <div class="absolute left-2 top-0 h-full w-px bg-rule" aria-hidden="true"></div>
          <div
            class:list={[
              'absolute left-0 top-8 h-4 w-4 rounded-full border-2 bg-paper',
              index === 0 ? 'border-accent' : 'border-rule',
            ]}
            aria-hidden="true"
          >
          </div>

          <article class="rounded-2xl border border-dashed border-rule bg-paper/90 p-5 shadow-sm backdrop-blur-sm">
            <header class="mb-4 flex flex-wrap items-center gap-3 text-sm text-ink-soft">
              <time datetime={scrap.data.date.toISOString()} class="font-medium text-ink">
                {formatDate(scrap.data.date)}
              </time>
              {scrap.data.tags.length > 0 && (
                <ul class="flex flex-wrap gap-2" aria-label="タグ一覧">
                  {scrap.data.tags.map((tag) => (
                    <li>
                      <a
                        href={`/scraps?tag=${encodeURIComponent(tag)}`}
                        class="rounded-full border border-dashed border-rule px-2.5 py-1 text-xs text-ink-soft transition-colors hover:border-accent hover:text-accent"
                      >
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </header>

            <div class="prose max-w-none">
              <Content />
            </div>
          </article>
        </li>
      ))}
    </ol>

    {renderedScraps.length === 0 && (
      <div class="rounded-2xl border border-dashed border-rule px-6 py-10 text-center text-ink-soft">
        該当するスクラップはまだありません。
      </div>
    )}
  </div>

  <MermaidScript />
</BaseLayout>
